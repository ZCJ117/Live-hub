  "cards": [
    {
      "dot": "cyan",
      "title": "接入与鉴权",
      "items": [
        "Nginx :8080 托管 hmdp 静态页，/api 反向代理到网关",
        "网关按路径前缀 lb:// 转发，Sa-Token 校验后放行",
        "网关与各业务服务同注册于 Nacos，共用同一个 Redis 存 Sa-Token 会话"
      ]
    },
    {
      "dot": "emerald",
      "title": "秒杀链路（异步为主）",
      "items": [
        "order 用 seckill.lua 原子预扣 Redis 库存 + 一人一单，随即返回 orderId",
        "发 seckill-order-topic，消费端加 Redisson 锁做幂等后经 Feign 让 voucher 扣库并落单",
        "重试 3 次仍失败转入 seckill-order-dlq-topic；Seata AT 仅包在同步兼容方法 createVoucherOrder 上"
      ]
    },
    {
      "dot": "violet",
      "title": "智能客服",
      "items": [
        "agent :8088 以 SSE 推送流式回答，ReAct 最多 8 步，Redis 存短期记忆",
        "工具体系：kb_search 检索 rag，另有 Feign 工具接口查 shop / voucher / order（图中仅示 agent→rag 与 agent→order）",
        "rag 先 pgvector 检索、RRF 融合，再交 GLM 生成；工单经 MQ 由 social 落站内信"
      ]
    },
    {
      "dot": "slate",
      "title": "数据与部署",
      "items": [
        "MySQL :3306 承载 hmdp（业务）与 agent_service（工单 / 会话）两套 schema",
        "PostgreSQL+pgvector :5433 rag_db 单独由 docker-compose 起，与业务库隔离",
        "Nacos / Seata / RocketMQ 由 Docker Desktop 提供，配置从 Nacos 导入"
      ]
    }
  ]
}